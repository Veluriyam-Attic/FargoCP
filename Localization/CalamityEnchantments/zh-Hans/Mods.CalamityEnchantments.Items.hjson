IntergelacticEnchant: {
	DisplayName: 异宇星凝魔石
	Tooltip:
		'''
		两个由小行星组成的星环围绕着你，星环的伤害取决于你的伤害加成
		神罚会将星环发射出去
		“消灭这只生物并不能阻止星辉瘟疫的扩散”
		'''
}

SlipperyShogunEnchant: {
	DisplayName: 神胶幕府魔石
	Tooltip:
		'''
		攻击时会向光标或附近敌怪发射黏液触须
		攻击时间越长，魔石充能越多，造成的伤害与射速提高
		高充能时，触须会精准锁定目标
		仆从攻击也会发射触须，但其充能基于仆从栏位，且会标记敌人
		（20及以上仆从栏为满充能，仆从触须有独立冷却）
