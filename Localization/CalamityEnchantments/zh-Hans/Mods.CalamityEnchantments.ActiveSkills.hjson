MolluskEffect1: {
	DisplayName: 巨蛤猛冲
	Tooltip:
		'''
		进行一次向下的贝壳猛冲
		猛冲击中敌怪造成大量伤害并提供你短暂的无敌帧
		仅在击中敌怪后进入冷却
		'''
}

UmbraphileEffect1: {
	DisplayName: 蝠群变身
	Tooltip:
		'''
		暂时变身为蝙蝠群
		在此形态下，你免疫所有伤害，移动速度提升30%，并获得无限飞行
		蝙蝠群会在命中时造成伤害并吸取生命
		'''
}

BrimflameEffect1: {
	DisplayName: 硫火怒张
	Tooltip: 消耗你的所有防御向所有方向释放一波硫磺火
}

AuricTeslaEffect: {
	DisplayName: 神罚
	Tooltip: 释放多种弹幕
}
