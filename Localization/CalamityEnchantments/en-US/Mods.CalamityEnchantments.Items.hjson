IntergelacticEnchant: {
	DisplayName: Intergelactic Enchantment
	Tooltip:
		'''
		Surrounds you with two rings of asteroids whose damages scale with your stats
		Divine Retribution sends these rings outwards
		'The destruction of this creature will not prevent the spread of the disease.'
		'''
}

SlipperyShogunEnchant: {
	DisplayName: Slippery Shogun Enchantment
	Tooltip:
		'''
		Goopy tendrils fire towards your cursor or nearby enemies as you attack
		The longer you attack, the more the Enchantment charges, increasing damage and fire rate
		With higher charge, Tendrils zero in on targets
		Minion attacks also fire tendrils, but this charge is based on minion slots and tags enemies
		(20+ slots act as full charge, and minion-summoned tendrils have a seperate cooldown)
		[i:CalamityHunt/GunkHeart] Effects of Gunk Heart
		'''
}

GeothermicEnchant: {
	DisplayName: Geothermic Enchantment
	Tooltip:
		'''
		Attacks occasionally launch mining debris
		All azafure equipment receive enhancements to thier abilities
		'''
}

SteamKnightEnchant: {
	DisplayName: Steam Knight Enchantment
	Tooltip:
		'''
		Attacking builds up vapor
		While fully charged, stop attacking to release burning steam in all directions
		While not attacking, vapor depletes faster than it charges
		All azafure equipment receive enhancements to thier abilities
		'''
}

AcropolisEnchant: {
	DisplayName: Acropolis Enchantment
	Tooltip:
		'''
		Replaces adrenaline with the durability bar
		The durability bar provides up to 36 defense and 24% damage reduction
		Durability is consumed based on damage taken when hit
		Durability slowly regenerates 5 seconds after taking damage
		When the durability bar is depleted, it becomes inactive and requires time to restore functionality
		Attacking builds up vapor and occasionally launches mining debris
		All azafure equipment receive enhancements to thier abilities
		'''
}

MariviniumEnchant: {
	DisplayName: Marivinium Enchantment
	Tooltip:
		'''
		Obtain 2 layers of shields, which will take 36 seconds to recover after being shattered
		After shields shatter, consume 100 life for 50% increased damage for 10 seconds
		Six tentacles heal you by stealing enemy life
		[i:CalamityEntropy/WyrmToothNecklace] Effects of Wyrm Tooth Necklace
		'''
}

AnarchalEnchant: {
	DisplayName: Anarchal Enchantment
	Tooltip:
		'''
		When taking more than 30 damage, releases three chaos cells
		Adds another cell for every 30 damage past the first
		Cells will chase and attack enemies before returning and healing you
		'''
}

NihilplasmicEnchant: {
	DisplayName: Nihilplasmic Enchantment
	Tooltip:
		'''
		Project a shield that can withstand 80 damage
		The nihility shield needs ten seconds to recover once broken
		Increases life regeneration while the shield is broken
		'''
}

EntropyTwinsTooltips: {
	Active: Active
	Inactive: Inactive
	Anarchal1: With the Nihilplasmic Enchantment, all attacks inflict Void Virus
	Anarchal2: If you or another player on your team have the Nihilplasmic Enchantment, all of your team's attacks inflict Void Virus
	Nihilplasmic1: With the Anarchal Enchantment, all attacks inflict Void Virus
	Nihilplasmic2: If you or another player on your team have the Anarchal Enchantment, all of your team's attacks inflict Void Virus
}

SmolderingEnchant: {
	DisplayName: Smoldering Enchantment
	Tooltip:
		'''
		You are surrounded by an inferno ring
		Gain a demonic tail that attacks nearby enemies and inflicts [cbuff:OnFire3]
		'''
}

EntropicFaquirEnchant: {
	DisplayName: Entropic Faquir Enchantment
	Tooltip:
		'''
		Gain a void charge bar
		Damaging enemies will fill the void charge bar
		With 10% void, summons a wraith
		When hurt, the wraith violently releases void
		Wraith damage and the duration of void release and cooldown increase with void charge
		Increases movement and flight speed based on the amount of void charge in the bar
		'''
}

SailfishEnchant: {
	DisplayName: Sailfish Enchantment
	Tooltip:
		'''
		All damage is buffed while mounted
		With no other mounts equipped, summons a royal jousting Velocicampus instead
		[i:CalamityFables/WarriorsAmphora] Effects of Warrior's Amphora
		'''
}
